<!-- Added by Wubarrk on 2026-10-13 for lakes and clearing (0.10.5). -->
<!-- Offline checks of the lakes and the clearing mask (LakeSet.cs, ClearMask.cs, LakeFiles.cs, ClearVegetation.cs, LakeTransfer.cs, LakeCommands.cs, and the lake
     engine's pure parts): Tarn's formats read and written, the mask against a transcription of Tarn's area test, the settings' keys 72 and 73 and what an older
     Better Continents does with them, the Directory's files, the push, the bc_lake words; and the flood, the spill and the tiles (Tests.<Part>.cs: every static
     method named *Test of the partial class Tests runs, so each part adds a file and no shared one).
     Build BetterContinents.csproj (Release) first: this references its pre-ILRepack DLL in obj/. Run from this folder with "dotnet run -c Release". -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Same name as the repo's harness so BetterContinents' InternalsVisibleTo("AltBiomeHarness") applies. -->
    <AssemblyName>AltBiomeHarness</AssemblyName>
    <RootNamespace>LakeTests</RootNamespace>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>$(NoWarn);MSB3277;CS8632;NU1701;MSB3243;CS1701;CS1702;CS0618</NoWarn>
    <LibsTools>$(MSBuildThisFileDirectory)../../../libs-Tools/</LibsTools>
    <BcDll>$(MSBuildThisFileDirectory)../../obj/Release/net4.8/BetterContinents.dll</BcDll>
  </PropertyGroup>
  <ItemGroup>
    <!-- BetterContinents.dll is built against BepInEx's HarmonyX 0Harmony, which cannot initialise on .NET 8;
         Lib.Harmony has the same assembly name and the API surface Better Continents touches here. -->
    <PackageReference Include="Lib.Harmony" Version="2.3.6" />
    <!-- The plugin's pre-ILRepack DLL refers to it (the maps are read with it); Better Continents' settings classes load it. -->
    <PackageReference Include="SixLabors.ImageSharp" Version="2.1.13" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="BetterContinents"><HintPath>$(BcDll)</HintPath></Reference>
    <Reference Include="assembly_valheim"><HintPath>$(LibsTools)1.0/client/assembly_valheim.dll</HintPath></Reference>
    <Reference Include="assembly_utils"><HintPath>$(LibsTools)1.0/client/assembly_utils.dll</HintPath></Reference>
    <Reference Include="UnityEngine"><HintPath>$(LibsTools)1.0/client/UnityEngine.dll</HintPath></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(LibsTools)1.0/client/UnityEngine.CoreModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(LibsTools)1.0/client/UnityEngine.PhysicsModule.dll</HintPath></Reference>
    <Reference Include="BepInEx"><HintPath>$(LibsTools)BepInEx.dll</HintPath></Reference>
  </ItemGroup>
  <ItemGroup>
    <None Include="fixtures/*" LinkBase="fixtures" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
