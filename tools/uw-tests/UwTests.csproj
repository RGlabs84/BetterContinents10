<!-- Added by Wubarrk on 2026-10-26 for Upgrade World compatibility (0.10.7). -->
<!-- Offline checks of Better Continents' side of Upgrade World (compatiblity/UW.cs, GenLoc.cs, the location pins) against the real
     UpgradeWorld.dll 1.87.0 (md5 2910b235b878e9ad4eb461691d4ad0d6; libs-Tools/1.0/thirdparty/upgrade-world-2026-10-26): every name Better
     Continents looks up by string, Upgrade World's own config bound for real, its locations_restore merge run with and without Better
     Continents' safeguard, and the game's ClearNonPlacedLocations under Upgrade World's skip. Build BetterContinents.csproj (Release) first:
     this references its pre-ILRepack DLL in obj/. Run from this folder with "dotnet run -c Release". -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Same name as the repo's harness so BetterContinents' InternalsVisibleTo("AltBiomeHarness") applies. -->
    <AssemblyName>AltBiomeHarness</AssemblyName>
    <RootNamespace>UwTests</RootNamespace>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>$(NoWarn);MSB3277;CS8632;NU1701;MSB3243;CS1701;CS1702;CS0618</NoWarn>
    <LibsTools>$(MSBuildThisFileDirectory)../../../libs-Tools/</LibsTools>
    <BcDll>$(MSBuildThisFileDirectory)../../obj/Release/net4.8/BetterContinents.dll</BcDll>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.3.6" />
    <PackageReference Include="SixLabors.ImageSharp" Version="2.1.13" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="BetterContinents"><HintPath>$(BcDll)</HintPath></Reference>
    <Reference Include="assembly_valheim"><HintPath>$(LibsTools)1.0/client/assembly_valheim.dll</HintPath></Reference>
    <Reference Include="SoftReferenceableAssets"><HintPath>$(LibsTools)1.0/client/SoftReferenceableAssets.dll</HintPath></Reference>
    <Reference Include="assembly_utils"><HintPath>$(LibsTools)1.0/client/assembly_utils.dll</HintPath></Reference>
    <Reference Include="UnityEngine"><HintPath>$(LibsTools)1.0/client/UnityEngine.dll</HintPath></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(LibsTools)1.0/client/UnityEngine.CoreModule.dll</HintPath></Reference>
    <Reference Include="BepInEx"><HintPath>$(LibsTools)BepInEx.dll</HintPath></Reference>
    <Reference Include="Mono.Cecil"><HintPath>$(LibsTools)Mono.Cecil.dll</HintPath></Reference>
  </ItemGroup>
</Project>
