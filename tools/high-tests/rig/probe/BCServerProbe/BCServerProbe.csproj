<!-- Added by Wubarrk on 2026-10-06 for 16k worlds (0.10.3). -->
<Project Sdk="Microsoft.NET.Sdk">
  <!-- Test-only probe for a headless dedicated server; see Plugin.cs and ../../README.txt. References as BCAutoTest's. Not part of tools/high-tests (HighTests.csproj leaves
       rig/ out). Where it is built outside the repository, say where libs-Tools is: dotnet build -c Release -p:L=/path/to/libs-Tools/ -->
  <PropertyGroup>
    <TargetFramework>net4.8</TargetFramework>
    <AssemblyName>BCServerProbe</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);CS0618;CS0649;CS8632</NoWarn>
    <L Condition="'$(L)' == ''">$(MSBuildThisFileDirectory)../../../../../../libs-Tools/</L>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="BepInEx"><HintPath>$(L)BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(L)0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="netstandard"><HintPath>$(L)netstandard.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(L)UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(L)UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(L)UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="assembly_valheim"><HintPath>$(L)assembly_valheim.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="assembly_utils"><HintPath>$(L)assembly_utils.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
